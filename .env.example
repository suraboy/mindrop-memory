# ==========================================
# MINDROP — ENVIRONMENT CONFIGURATION
# ==========================================

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- DATABASE & VECTOR MEMORY (SUPABASE / POSTGRES + PGVECTOR) ---
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- LINE BOT INGESTION GATEWAY ---
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"
LINE_CHANNEL_SECRET="your-line-channel-secret"

# --- OBJECT STORAGE (S3 / CLOUDFLARE R2 FOR IMAGES & FILES) ---
STORAGE_PROVIDER="r2" # r2 | s3 | supabase
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="mindrop-captures"
R2_PUBLIC_DOMAIN="https://cdn.yourdomain.com"

# --- AI MODELS & EMBEDDING HARNESS ---
OPENAI_API_KEY="sk-..."
EMBEDDING_MODEL="text-embedding-3-small"
LLM_MODEL="gpt-4o-mini"

# Optional: Google Gemini / Anthropic
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
